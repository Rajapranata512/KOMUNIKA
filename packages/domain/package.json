{
  "name": "@aksara/domain",
  "version": "0.0.0",
  "private": true,
  "types": "./src/index.ts",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --passWithNoTests",
    "test:a11y": "vitest run --passWithNoTests",
    "test:visual": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
