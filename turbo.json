{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_ENV", "APP_BASE_URL", "API_BASE_URL", "EMAIL_DELIVERY_MODE"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": [
        "ANTIVIRUS_HOST",
        "ANTIVIRUS_PORT",
        "API_BASE_URL",
        "APP_BASE_URL",
        "APP_ENV",
        "CSRF_SECRET",
        "DATABASE_URL",
        "EMAIL_DELIVERY_MODE",
        "FILE_SCAN_MODE",
        "MFA_ENCRYPTION_KEY",
        "OBJECT_STORAGE_ACCESS_KEY",
        "OBJECT_STORAGE_BUCKET_PRIVATE",
        "OBJECT_STORAGE_BUCKET_PUBLIC",
        "OBJECT_STORAGE_ENDPOINT",
        "OBJECT_STORAGE_REGION",
        "OBJECT_STORAGE_SECRET_KEY",
        "PUBLICATION_SCHEDULER_MODE",
        "REDIS_URL",
        "SESSION_SECRET"
      ],
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:a11y": {
      "cache": false
    },
    "test:visual": {
      "cache": false
    }
  }
}
