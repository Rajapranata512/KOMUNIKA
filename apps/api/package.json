{
  "name": "@aksara/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/",
    "test:integration": "dotenv -e ../../.env -- vitest run --no-file-parallelism test/health.integration.test.ts test/auth.integration.test.ts test/journal.integration.test.ts test/profile.integration.test.ts test/admin.integration.test.ts test/mfa.integration.test.ts test/submission.integration.test.ts test/editorial.integration.test.ts test/review.integration.test.ts test/decision.integration.test.ts test/production.integration.test.ts",
    "test:storage-smoke": "dotenv -e ../../.env -- pnpm --filter @aksara/database exec tsx ../../apps/api/test/file-pipeline.smoke.ts",
    "test:email-smoke": "dotenv -e ../../.env -- pnpm --filter @aksara/database exec tsx ../../apps/api/test/email-pipeline.smoke.ts",
    "test:telemetry-smoke": "tsx test/telemetry.smoke.ts",
    "test:e2e": "vitest run --passWithNoTests",
    "test:a11y": "vitest run --passWithNoTests",
    "test:visual": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aksara/config": "workspace:*",
    "@aksara/database": "workspace:*",
    "@aksara/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/s3-request-presigner": "3.1114.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@sentry/nestjs": "10.70.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.56.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^10.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
